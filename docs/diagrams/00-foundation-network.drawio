<mxfile host="drawio" compressed="false">
  <diagram id="p0-foundation-network" name="P0 Foundation network">
    <mxGraphModel background="#FFFFFF" dx="1500" dy="720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="720" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;font style=&quot;font-size:20px&quot;&gt;&lt;b&gt;P0 Foundation: network&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Session nodes are private (no public IPs) on a custom VPC (Virtual Private Cloud). The laptop and GitHub reach only the GKE (Google Kubernetes Engine) control plane, where IAM (Identity and Access Management) decides who gets in." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#2C2C2A;" vertex="1" parent="1">
          <mxGeometry x="20" y="12" width="1460" height="60" as="geometry" />
        </mxCell>
        <mxCell id="zI" value="Internet · outside Google Cloud" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=3;container=1;collapsible=0;fontStyle=1;fontSize=13;align=left;spacingLeft=12;fillColor=#FFFFFF;swimlaneFillColor=#FFFFFF;strokeColor=#5F5E5A;fontColor=#2C2C2A;" vertex="1" parent="1">
          <mxGeometry x="20" y="90" width="330" height="220" as="geometry" />
        </mxCell>
        <mxCell id="L1" value="&lt;b&gt;Laptop (you)&lt;/b&gt;&lt;br&gt;kubectl, make" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="zI">
          <mxGeometry x="20" y="40" width="290" height="70" as="geometry" />
        </mxCell>
        <mxCell id="G1" value="&lt;b&gt;GitHub runners&lt;/b&gt;&lt;br&gt;session workflows" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="zI">
          <mxGeometry x="20" y="130" width="290" height="70" as="geometry" />
        </mxCell>
        <mxCell id="CP" value="&lt;b&gt;GKE control plane&lt;/b&gt;&lt;br&gt;Google-managed, DNS-based endpoint&lt;br&gt;IAM decides who gets in, no IP allowlist" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#2C2C2A;fontSize=12;align=left;verticalAlign=middle;spacingLeft=58;spacingRight=8;" vertex="1" parent="1">
