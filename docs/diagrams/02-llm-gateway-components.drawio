<mxfile host="drawio" compressed="false">
  <diagram id="p2-llm-gateway-components" name="P2 LLM gateway components">
    <mxGraphModel background="#FFFFFF" dx="1880" dy="1060" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1880" pageHeight="1060" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;font style=&quot;font-size:20px&quot;&gt;&lt;b&gt;P2 LLM gateway: components&lt;/b&gt;&lt;/font&gt;&lt;br&gt;One OpenAI-compatible front door in GKE (Google Kubernetes Engine): team keys, budgets, rate limits, fallback from our vLLM to Claude on Vertex AI, and PII masking before a prompt leaves the cluster. Reached only through kubectl port-forward; nothing is public." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#2C2C2A;" vertex="1" parent="1">
          <mxGeometry x="20" y="12" width="1540" height="60" as="geometry" />
        </mxCell>
        <mxCell id="zT" value="GitHub Actions and the laptop" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=3;container=1;collapsible=0;fontStyle=1;fontSize=13;align=left;spacingLeft=12;fillColor=#FFFFFF;swimlaneFillColor=#FFFFFF;strokeColor=#5F5E5A;fontColor=#2C2C2A;" vertex="1" parent="1">
          <mxGeometry x="20" y="85" width="1560" height="165" as="geometry" />
        </mxCell>
        <mxCell id="ciN" value="&lt;b&gt;ci.yml&lt;/b&gt; on every pull request: LiteLLM, Postgres, Presidio and the mock provider run as containers on the runner, for all P2 tests. Never touches GCP (Google Cloud Platform)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#444441;" vertex="1" parent="zT">
          <mxGeometry x="20" y="40" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="relN" value="&lt;b&gt;release.yml&lt;/b&gt; (built and CI-checked, no tag yet): publishes the gateway chart only." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#444441;" vertex="1" parent="zT">
          <mxGeometry x="360" y="40" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="zCall" value="Callers · kubectl port-forward only · each team uses its own virtual key" style="html=1;whiteSpace=wrap;rounded=1;arcSize=4;container=1;collapsible=0;fontStyle=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontColor=#2C2C2A;" vertex="1" parent="zT">
          <mxGeometry x="650" y="36" width="890" height="115" as="geometry" />
        </mxCell>
        <mxCell id="G2" value="&lt;b&gt;gpu-session.yml&lt;/b&gt; · gateway mode (deployer account)&lt;br&gt;both sessions: without and with the GPU&lt;br&gt;up → installs → tests, benchmark → down" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="zCall">
          <mxGeometry x="20" y="32" width="410" height="72" as="geometry" />
        </mxCell>
        <mxCell id="LAP" value="&lt;b&gt;Laptop&lt;/b&gt; · demo only (deployer, by impersonation)&lt;br&gt;make up → make team → demo → make down&lt;br&gt;the only place a team key is printed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="zCall">
          <mxGeometry x="460" y="32" width="410" height="72" as="geometry" />
        </mxCell>
        <mxCell id="zS" value="Session: GKE zonal cluster + Cloud NAT (from P1)" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=3;container=1;collapsible=0;fontStyle=1;fontSize=13;align=left;spacingLeft=12;fillColor=#EEEDFE;swimlaneFillColor=#F7F6FF;strokeColor=#534AB7;fontColor=#3C3489;" vertex="1" parent="1">
          <mxGeometry x="20" y="290" width="1180" height="670" as="geometry" />
        </mxCell>
        <mxCell id="sN" value="Private nodes. No load balancer and no public IP. LiteLLM, Postgres, Presidio, OTel Collector and python images come through Cloud NAT, pinned by version." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#3C3489;" vertex="1" parent="zS">
          <mxGeometry x="20" y="36" width="560" height="44" as="geometry" />
        </mxCell>
        <mxCell id="zSys" value="System node pool · 1× e2-standard-4 · everything P2 installs runs here" style="html=1;whiteSpace=wrap;rounded=1;arcSize=3;container=1;collapsible=0;fontStyle=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fillColor=#FFFFFF;strokeColor=#534AB7;fontColor=#3C3489;" vertex="1" parent="zS">
          <mxGeometry x="20" y="90" width="1140" height="440" as="geometry" />
        </mxCell>
        <mxCell id="GW" value="&lt;b&gt;LLM gateway&lt;/b&gt; (LiteLLM, pending the one-day gateway trial)&lt;br&gt;OpenAI-compatible API, one replica&lt;br&gt;team keys, budgets, rate limits, fallback" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#534AB7;fontColor=#2C2C2A;fontSize=12;align=left;verticalAlign=middle;spacingLeft=60;spacingRight=8;" vertex="1" parent="zSys">
          <mxGeometry x="400" y="60" width="380" height="120" as="geometry" />
        </mxCell>
        <mxCell id="GWi" value="" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#2875E2;strokeColor=#ffffff;points=[[0.005,0.63,0],[0.1,0.2,0],[0.9,0.2,0],[0.5,0,0],[0.995,0.63,0],[0.72,0.99,0],[0.5,1,0],[0.28,0.99,0]];shape=mxgraph.kubernetes.icon2;prIcon=pod" vertex="1" parent="GW">
          <mxGeometry x="10" y="40" width="42" height="40" as="geometry" />
        </mxCell>
        <mxCell id="PG" value="&lt;b&gt;Postgres&lt;/b&gt; · one pod, no disk&lt;br&gt;teams, keys, spend logs&lt;br&gt;data lasts one session" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#534AB7;fontColor=#2C2C2A;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="zSys">
          <mxGeometry x="20" y="75" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="PR" value="&lt;b&gt;PII masking&lt;/b&gt; (Presidio analyzer + anonymizer)&lt;br&gt;every request that can reach a hosted model, fallbacks included&lt;br&gt;(all traffic, if the trial finds that is the free option)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#534AB7;fontColor=#2C2C2A;fontSize=11;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="zSys">
          <mxGeometry x="880" y="45" width="240" height="95" as="geometry" />
        </mxCell>
        <mxCell id="BE" value="&lt;b&gt;Overhead benchmark Job&lt;/b&gt; (P1&#39;s vllm bench serve)&lt;br&gt;same load straight to vLLM and through the gateway, at 10 and 50 concurrent" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#534AB7;fontColor=#2C2C2A;fontSize=11;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="zSys">
          <mxGeometry x="20" y="280" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="OT" value="&lt;b&gt;OTel Collector&lt;/b&gt; (minimal)&lt;br&gt;receives gateway telemetry&lt;br&gt;P3 completes it" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#534AB7;fontColor=#2C2C2A;fontSize=11;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="zSys">
          <mxGeometry x="540" y="280" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="MK" value="&lt;b&gt;Mock provider&lt;/b&gt; · test only (CI and session tests)&lt;br&gt;OpenAI-shaped, records every payload&lt;br&gt;one Python file on a pinned python image" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FAEEDA;strokeColor=#BA7517;fontColor=#2C2C2A;fontSize=11;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="zSys">
          <mxGeometry x="860" y="280" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="P1" value="&lt;b&gt;Layer below: P1 GPU serving&lt;/b&gt; (see the 01-gpu-serving diagram)&lt;br&gt;vLLM Service vllm.vllm.svc:8000 (Qwen2.5-7B on the NVIDIA L4 GPU pool, which starts at 0 nodes), KEDA and Prometheus. Installed in the GPU run and the demo, not in the GPU-less shakedown." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F1EFE8;strokeColor=#888780;fontColor=#444441;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="zS">
          <mxGeometry x="20" y="550" width="1140" height="100" as="geometry" />
        </mxCell>
        <mxCell id="zF" value="Foundation · always on" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=3;container=1;collapsible=0;fontStyle=1;fontSize=13;align=left;spacingLeft=12;fillColor=#F1EFE8;swimlaneFillColor=#F8F7F3;strokeColor=#888780;fontColor=#444441;" vertex="1" parent="1">
          <mxGeometry x="1240" y="290" width="340" height="160" as="geometry" />
        </mxCell>
        <mxCell id="SM" value="&lt;b&gt;Secret Manager&lt;/b&gt; · master key, Postgres password&lt;br&gt;new random version at each make up (deployer)&lt;br&gt;make team reads the master key into memory" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=11;align=left;verticalAlign=middle;spacingLeft=60;spacingRight=8;" vertex="1" parent="zF">
          <mxGeometry x="20" y="45" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="SMi" value="" style="sketch=0;html=1;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;align=center;spacingTop=-6;fontSize=11;fontStyle=1;fontColor=#999999;shape=image;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="SM">
          <mxGeometry x="9" y="37" width="42" height="25" as="geometry" />
        </mxCell>
        <mxCell id="zG" value="Google Cloud APIs · Private Google Access, no NAT" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=3;container=1;collapsible=0;fontStyle=1;fontSize=12;align=left;spacingLeft=12;fillColor=#FFFFFF;swimlaneFillColor=#FFFFFF;strokeColor=#5F5E5A;fontColor=#2C2C2A;" vertex="1" parent="1">
          <mxGeometry x="1240" y="470" width="340" height="150" as="geometry" />
        </mxCell>
        <mxCell id="VX" value="&lt;b&gt;Claude Haiku 5.5 on Vertex AI&lt;/b&gt; (chat-hosted)&lt;br&gt;keyless: the gateway&#39;s Kubernetes service account, Workload Identity, roles/aiplatform.user" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=11;align=left;verticalAlign=middle;spacingLeft=58;spacingRight=8;" vertex="1" parent="zG">
          <mxGeometry x="20" y="45" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="VXi" value="" style="editableCssRules=.*;html=1;shape=image;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="VX">
          <mxGeometry x="10" y="27" width="40" height="36" as="geometry" />
        </mxCell>
        <mxCell id="P0" value="&lt;b&gt;Layer below: P0 foundation&lt;/b&gt; (see the 00-foundation diagrams) · custom VPC (Virtual Private Cloud) with private nodes and Private Google Access · keyless GitHub login through WIF (Workload Identity Federation), main branch only · deployer and node service accounts · budget alerts · nightly cost-guard" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F1EFE8;strokeColor=#888780;fontColor=#444441;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="20" y="980" width="1560" height="60" as="geometry" />
        </mxCell>
        <mxCell id="lg" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#888780;" vertex="1" parent="1">
          <mxGeometry x="1600" y="290" width="260" height="410" as="geometry" />
        </mxCell>
        <mxCell id="lgT" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#2C2C2A;" vertex="1" parent="lg">
          <mxGeometry x="10" y="8" width="240" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lgL1" value="" style="line;html=1;strokeWidth=1.5;strokeColor=#5F5E5A;" vertex="1" parent="lg">
          <mxGeometry x="12" y="40" width="44" height="10" as="geometry" />
        </mxCell>
        <mxCell id="lgL1t" value="Call, in request order 1–8 (a number used twice marks alternative routes)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#2C2C2A;" vertex="1" parent="lg">
          <mxGeometry x="64" y="33" width="186" height="24" as="geometry" />
        </mxCell>
        <mxCell id="lgS1" value="" style="rounded=1;html=1;fillColor=#FAEEDA;strokeColor=#BA7517;" vertex="1" parent="lg">
          <mxGeometry x="12" y="72" width="44" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lgS1t" value="Test only (amber box and line): never a real route" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#2C2C2A;" vertex="1" parent="lg">
          <mxGeometry x="64" y="66" width="186" height="32" as="geometry" />
        </mxCell>
        <mxCell id="lgS2" value="" style="rounded=1;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;" vertex="1" parent="lg">
          <mxGeometry x="12" y="112" width="44" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lgS2t" value="Exists only during a session (make up to make down)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#2C2C2A;" vertex="1" parent="lg">
          <mxGeometry x="64" y="106" width="186" height="32" as="geometry" />
        </mxCell>
        <mxCell id="lgS3" value="" style="rounded=1;html=1;fillColor=#F1EFE8;strokeColor=#888780;" vertex="1" parent="lg">
          <mxGeometry x="12" y="152" width="44" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lgS3t" value="Always on, or a layer below (drawn in its own diagram)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#2C2C2A;" vertex="1" parent="lg">
          <mxGeometry x="64" y="146" width="186" height="32" as="geometry" />
        </mxCell>
        <mxCell id="lgN" value="LLM: large language model. PII: personally identifiable information, such as emails and phone numbers. OTel: OpenTelemetry. NAT: network address translation. vLLM: the open-source model server from P1. L4: the NVIDIA GPU it runs on. KEDA: Kubernetes Event-driven Autoscaling. Presidio: Microsoft&#39;s open-source PII detector. OpenAI-compatible: the same API shape as OpenAI&#39;s, so apps need no changes. Virtual key: a team&#39;s own gateway key, never a provider key." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#444441;" vertex="1" parent="lg">
          <mxGeometry x="10" y="190" width="240" height="210" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="1 secrets mounted" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5F5E5A;strokeWidth=1.5;fontSize=12;fontColor=#2C2C2A;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=0.8947;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="SM" target="GW">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="780" y="405" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e2" value="2 team setup + chat" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5F5E5A;strokeWidth=1.5;fontSize=12;fontColor=#2C2C2A;labelBackgroundColor=#FFFFFF;exitX=0.0337;exitY=1;exitDx=0;exitDy=0;entryX=0.6842;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="zCall" target="GW">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="3 keys, budgets" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5F5E5A;strokeWidth=1.5;fontSize=12;fontColor=#2C2C2A;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="zSys" source="GW" target="PG">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="4 chat-default" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5F5E5A;strokeWidth=1.5;fontSize=12;fontColor=#2C2C2A;labelBackgroundColor=#FFFFFF;exitX=0.2632;exitY=1;exitDx=0;exitDy=0;entryX=0.4386;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="zS" source="GW" target="P1">
          <mxGeometry x="-0.55" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e5" value="5 mask PII" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5F5E5A;strokeWidth=1.5;fontSize=12;fontColor=#2C2C2A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.2083;exitDx=0;exitDy=0;entryX=0;entryY=0.4211;entryDx=0;entryDy=0;" edge="1" parent="zSys" source="GW" target="PR">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="6 hosted · fallback" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5F5E5A;strokeWidth=1.5;fontSize=12;fontColor=#2C2C2A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.875;exitDx=0;exitDy=0;entryX=0;entryY=0.3333;entryDx=0;entryDy=0;" edge="1" parent="1" source="GW" target="VX">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="6 test alias" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#BA7517;strokeWidth=1.5;fontSize=12;fontColor=#854F0B;labelBackgroundColor=#FFFFFF;exitX=0.9474;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="zSys" source="GW" target="MK">
          <mxGeometry x="-0.5" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="760" y="325" />
