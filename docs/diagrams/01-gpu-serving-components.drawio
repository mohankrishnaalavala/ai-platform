        <mxCell id="idN" value="Workload Identity, no keys: vLLM may only read the models bucket; the benchmark may only write the results bucket. The deployer may only create objects there too." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#444441;" vertex="1" parent="zF">
