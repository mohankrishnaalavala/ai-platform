        <mxCell id="zSys" value="System node pool · 1× e2-standard-4" style="html=1;whiteSpace=wrap;rounded=1;arcSize=3;container=1;collapsible=0;fontStyle=1;fontSize=12;align=left;verticalAlign=bottom;spacingLeft=12;spacingBottom=6;fillColor=#FFFFFF;strokeColor=#534AB7;fontColor=#3C3489;" vertex="1" parent="zS">
