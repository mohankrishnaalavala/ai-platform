        <mxCell id="V2" value="&lt;b&gt;vLLM replica 2&lt;/b&gt;&lt;br&gt;needs GPU quota 2 (denied 2026-10-16): stays Pending; the scale-out test records KEDA's request" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;dashed=1;dashPattern=6 4;fillColor=#FFFFFF;strokeColor=#888780;fontColor=#5F5E5A;fontSize=11;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="zGpu">
          <mxGeometry x="20" y="40" width="320" height="105" as="geometry" />
        </mxCell>
