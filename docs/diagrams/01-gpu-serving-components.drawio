<mxfile host="drawio" compressed="false">
  <diagram id="p1-gpu-serving-components" name="P1 GPU serving components">
    <mxGraphModel background="#FFFFFF" dx="1880" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1880" pageHeight="950" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;font style=&quot;font-size:20px&quot;&gt;&lt;b&gt;P1 GPU serving: components&lt;/b&gt;&lt;/font&gt;&lt;br&gt;vLLM serves Qwen2.5-7B on one spot NVIDIA L4 GPU (graphics processing unit) in GKE (Google Kubernetes Engine). KEDA scales it on requests waiting in vLLM's queue. Everything runs from GitHub Actions; nothing is public." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#2C2C2A;" vertex="1" parent="1">
          <mxGeometry x="20" y="12" width="1500" height="60" as="geometry" />
        </mxCell>
        <mxCell id="zG" value="GitHub (public repo)" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=3;container=1;collapsible=0;fontStyle=1;fontSize=13;align=left;spacingLeft=12;fillColor=#FFFFFF;swimlaneFillColor=#FFFFFF;strokeColor=#5F5E5A;fontColor=#2C2C2A;" vertex="1" parent="1">
          <mxGeometry x="20" y="90" width="1540" height="190" as="geometry" />
        </mxCell>
        <mxCell id="ciN" value="&lt;b&gt;ci.yml&lt;/b&gt; on pull requests: static checks only (helm lint, chart schema check, ruff, unit tests). Never touches GCP (Google Cloud Platform)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#444441;" vertex="1" parent="zG">
          <mxGeometry x="20" y="50" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="G2" value="&lt;b&gt;gpu-session.yml&lt;/b&gt; (manual, deployer account)&lt;br&gt;up → Helm installs → smoke test&lt;br&gt;bench, cold starts, scale-out → down" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="zG">
          <mxGeometry x="320" y="50" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="lapN" value="&lt;b&gt;Laptop:&lt;/b&gt; only make foundation-apply (as the terraform account) and starting workflows. Nothing large goes through it; there is no laptop mode." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#444441;" vertex="1" parent="zG">
          <mxGeometry x="660" y="50" width="480" height="110" as="geometry" />
        </mxCell>
        <mxCell id="G1" value="&lt;b&gt;mirror.yml&lt;/b&gt; (once, mirror account)&lt;br&gt;vLLM image from Docker Hub (crane copy)&lt;br&gt;weights from Hugging Face" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="zG">
          <mxGeometry x="1200" y="50" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="zS" value="Session: GKE zonal cluster + Cloud NAT" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=3;container=1;collapsible=0;fontStyle=1;fontSize=13;align=left;spacingLeft=12;fillColor=#EEEDFE;swimlaneFillColor=#F7F6FF;strokeColor=#534AB7;fontColor=#3C3489;" vertex="1" parent="1">
          <mxGeometry x="20" y="350" width="980" height="490" as="geometry" />
        </mxCell>
        <mxCell id="sN" value="Private nodes, DNS-only control plane. No public endpoint and no load balancer: vLLM is reachable only inside the cluster." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#3C3489;" vertex="1" parent="zS">
          <mxGeometry x="20" y="40" width="550" height="80" as="geometry" />
        </mxCell>
        <mxCell id="NAT" value="&lt;b&gt;Cloud NAT&lt;/b&gt; + Cloud Router&lt;br&gt;egress only (network address translation)&lt;br&gt;KEDA + Prometheus images, baseline pulls" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#534AB7;fontColor=#2C2C2A;fontSize=11;align=left;verticalAlign=middle;spacingLeft=56;spacingRight=8;" vertex="1" parent="zS">
          <mxGeometry x="600" y="40" width="340" height="80" as="geometry" />
        </mxCell>
        <mxCell id="NATi" value="" style="editableCssRules=.*;html=1;shape=image;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="NAT">
          <mxGeometry x="10" y="20" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="zGpu" value="GPU node pool · g2-standard-8 + 1× NVIDIA L4 · spot · 0–2 nodes" style="html=1;whiteSpace=wrap;rounded=1;arcSize=3;container=1;collapsible=0;fontStyle=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fillColor=#FFFFFF;strokeColor=#534AB7;fontColor=#3C3489;" vertex="1" parent="zS">
