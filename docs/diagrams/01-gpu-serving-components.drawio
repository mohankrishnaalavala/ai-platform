          <mxGeometry x="20" y="15" width="260" height="85" as="geometry" />
        </mxCell>
        <mxCell id="PROM" value="&lt;b&gt;Prometheus&lt;/b&gt; (kube-prometheus-stack)&lt;br&gt;Prometheus only, short retention" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#534AB7;fontColor=#2C2C2A;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="zSys">
          <mxGeometry x="390" y="15" width="260" height="85" as="geometry" />
        </mxCell>
        <mxCell id="BENCH" value="&lt;b&gt;Benchmark Job&lt;/b&gt; (vllm bench serve)&lt;br&gt;same vLLM image, in the cluster" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#534AB7;fontColor=#2C2C2A;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="zSys">
