<mxfile host="drawio" compressed="false">
  <diagram id="p3-llm-observability-components" name="P3 LLM observability components">
    <mxGraphModel background="#FFFFFF" dx="1700" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;font style=&quot;font-size:20px&quot;&gt;&lt;b&gt;P3 LLM observability: components&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Traces, metrics, SLO (service level objective) burn-rate alerts and cost per team for the P2 gateway and P1&#39;s vLLM, plus scale from zero. Every P3 pod runs on the system node of the session GKE (Google Kubernetes Engine) cluster. Reached only through kubectl port-forward; nothing is public." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#2C2C2A;" vertex="1" parent="1">
          <mxGeometry x="20" y="12" width="1660" height="60" as="geometry" />
        </mxCell>
        <mxCell id="zT" value="GitHub Actions" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=3;container=1;collapsible=0;fontStyle=1;fontSize=13;align=left;spacingLeft=12;fillColor=#FFFFFF;swimlaneFillColor=#FFFFFF;strokeColor=#5F5E5A;fontColor=#2C2C2A;" vertex="1" parent="1">
          <mxGeometry x="20" y="85" width="1660" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ciN" value="&lt;b&gt;ci.yml&lt;/b&gt; on every pull request: Sloth (SLO generator) runs as a CLI and writes the burn-rate rules from slos/; the generated rules are committed. promtool and amtool check rules and alerts. Never touches GCP (Google Cloud Platform)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#444441;" vertex="1" parent="zT">
          <mxGeometry x="20" y="34" width="780" height="60" as="geometry" />
        </mxCell>
        <mxCell id="gsN" value="&lt;b&gt;gpu-session.yml&lt;/b&gt; · obs-shakedown and obs-full modes, deployer account (keyless): Helm installs everything below, then make test P=03, the game day and the Grafana screenshots through port-forward, then make down." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#444441;" vertex="1" parent="zT">
          <mxGeometry x="840" y="34" width="800" height="60" as="geometry" />
        </mxCell>
        <mxCell id="zS" value="Session: GKE zonal cluster · Dataplane V2 on · Cloud NAT (from P1)" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=3;container=1;collapsible=0;fontStyle=1;fontSize=13;align=left;spacingLeft=12;fillColor=#EEEDFE;swimlaneFillColor=#F7F6FF;strokeColor=#534AB7;fontColor=#3C3489;" vertex="1" parent="1">
          <mxGeometry x="20" y="215" width="1300" height="690" as="geometry" />
        </mxCell>
        <mxCell id="sN" value="Private nodes. No load balancer and no public IP. P3 adds no secrets and no Google service accounts: its pods never call Google APIs. P3&#39;s images come through Cloud NAT, pinned by version." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#3C3489;" vertex="1" parent="zS">
          <mxGeometry x="20" y="36" width="1260" height="40" as="geometry" />
        </mxCell>
        <mxCell id="zSys" value="System node pool · 1× e2-standard-8 · every P3 pod runs here" style="html=1;whiteSpace=wrap;rounded=1;arcSize=3;container=1;collapsible=0;fontStyle=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fillColor=#FFFFFF;strokeColor=#534AB7;fontColor=#3C3489;" vertex="1" parent="zS">
          <mxGeometry x="20" y="85" width="1260" height="400" as="geometry" />
        </mxCell>
        <mxCell id="GF" value="&lt;b&gt;Dashboards&lt;/b&gt; (Grafana)&lt;br&gt;3 dashboards from Git&lt;br&gt;anonymous Viewer, no admin" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#534AB7;fontColor=#2C2C2A;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="zSys">
          <mxGeometry x="20" y="155" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="RC" value="&lt;b&gt;Alert recorder&lt;/b&gt; (our webhook)&lt;br&gt;one Python file, from a ConfigMap&lt;br&gt;its timestamps give time to alert" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#534AB7;fontColor=#2C2C2A;fontSize=11;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="zSys">
          <mxGeometry x="20" y="267" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ST" value="No disks: data lasts one session" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;container=1;collapsible=0;fillColor=none;strokeColor=#534AB7;fontColor=#3C3489;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;" vertex="1" parent="zSys">
          <mxGeometry x="330" y="30" width="270" height="330" as="geometry" />
        </mxCell>
        <mxCell id="TP" value="&lt;b&gt;Trace store&lt;/b&gt; (Tempo)&lt;br&gt;single binary, no disk" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#534AB7;fontColor=#2C2C2A;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="ST">
          <mxGeometry x="15" y="40" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="PM" value="&lt;b&gt;Metrics and alerts&lt;/b&gt; (kube-prometheus-stack)&lt;br&gt;P1&#39;s Prometheus + Alertmanager&lt;br&gt;SLO and fallback rules from Git" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#534AB7;fontColor=#2C2C2A;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="ST">
          <mxGeometry x="15" y="180" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="OT" value="&lt;b&gt;Telemetry pipeline&lt;/b&gt;&lt;br&gt;(OpenTelemetry Collector, from P2)&lt;br&gt;P3 adds span metrics" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#534AB7;fontColor=#2C2C2A;fontSize=11;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="zSys">
          <mxGeometry x="700" y="70" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="GW" value="&lt;b&gt;Layer below: P2 LLM gateway&lt;/b&gt;&lt;br&gt;LiteLLM + Presidio + Postgres&lt;br&gt;chat-default → vLLM, else Gemini" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F1EFE8;strokeColor=#888780;fontColor=#444441;fontSize=11;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="zSys">
          <mxGeometry x="1030" y="65" width="210" height="90" as="geometry" />
        </mxCell>
        <mxCell id="KD" value="&lt;b&gt;Scale from zero&lt;/b&gt; (KEDA, from P1)&lt;br&gt;new trigger: chat-default rate&lt;br&gt;vLLM minimum 0 replicas" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#534AB7;fontColor=#2C2C2A;fontSize=11;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="zSys">
          <mxGeometry x="1030" y="225" width="210" height="90" as="geometry" />
        </mxCell>
        <mxCell id="zGpu" value="GPU node pool · g2-standard-8 + 1× NVIDIA L4 · starts at 0 nodes" style="html=1;whiteSpace=wrap;rounded=1;arcSize=3;container=1;collapsible=0;fontStyle=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fillColor=#FFFFFF;strokeColor=#534AB7;fontColor=#3C3489;" vertex="1" parent="zS">
          <mxGeometry x="20" y="530" width="1260" height="140" as="geometry" />
        </mxCell>
        <mxCell id="DC" value="&lt;b&gt;GPU metrics exporter&lt;/b&gt;&lt;br&gt;(GKE-managed NVIDIA DCGM)&lt;br&gt;Google runs it; P3 only scrapes it" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=11;align=left;verticalAlign=middle;spacingLeft=60;spacingRight=8;" vertex="1" parent="zGpu">
          <mxGeometry x="20" y="40" width="290" height="80" as="geometry" />
        </mxCell>
        <mxCell id="DCi" value="" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#2875E2;strokeColor=#ffffff;points=[[0.005,0.63,0],[0.1,0.2,0],[0.9,0.2,0],[0.5,0,0],[0.995,0.63,0],[0.72,0.99,0],[0.5,1,0],[0.28,0.99,0]];shape=mxgraph.kubernetes.icon2;prIcon=pod" vertex="1" parent="DC">
          <mxGeometry x="10" y="20" width="42" height="40" as="geometry" />
        </mxCell>
        <mxCell id="P1" value="&lt;b&gt;Layer below: P1 vLLM&lt;/b&gt;&lt;br&gt;Qwen2.5-7B on the L4 GPU&lt;br&gt;(see the 01 diagram)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F1EFE8;strokeColor=#888780;fontColor=#444441;fontSize=11;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="zGpu">
          <mxGeometry x="1015" y="40" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="zG" value="Google Cloud APIs · Private Google Access" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=3;container=1;collapsible=0;fontStyle=1;fontSize=12;align=left;spacingLeft=12;fillColor=#FFFFFF;swimlaneFillColor=#FFFFFF;strokeColor=#5F5E5A;fontColor=#2C2C2A;" vertex="1" parent="1">
          <mxGeometry x="1400" y="330" width="280" height="140" as="geometry" />
        </mxCell>
        <mxCell id="VX" value="&lt;b&gt;Gemini on Vertex AI&lt;/b&gt;&lt;br&gt;P2&#39;s hosted fallback&lt;br&gt;keyless: Workload Identity" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=11;align=left;verticalAlign=middle;spacingLeft=60;spacingRight=8;" vertex="1" parent="zG">
          <mxGeometry x="20" y="40" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="VXi" value="" style="sketch=0;html=1;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;align=center;fontSize=11;fontStyle=0;fontColor=#000000;aspect=fixed;pointerEvents=1;shape=mxgraph.gcp3.vertexai;fillColor=#4285f4" vertex="1" parent="VX">
          <mxGeometry x="10" y="20" width="40" height="39" as="geometry" />
        </mxCell>
        <mxCell id="lg" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#888780;" vertex="1" parent="1">
          <mxGeometry x="1400" y="500" width="280" height="400" as="geometry" />
        </mxCell>
        <mxCell id="lgT" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#2C2C2A;" vertex="1" parent="lg">
          <mxGeometry x="10" y="8" width="260" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lgL1" value="" style="line;html=1;strokeWidth=1.5;strokeColor=#5F5E5A;" vertex="1" parent="lg">
          <mxGeometry x="12" y="40" width="44" height="10" as="geometry" />
        </mxCell>
        <mxCell id="lgL1t" value="Call, in request order 1–8. Two lines numbered 3: one scrape, two targets" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#2C2C2A;" vertex="1" parent="lg">
          <mxGeometry x="64" y="28" width="206" height="36" as="geometry" />
        </mxCell>
        <mxCell id="lgS1" value="" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#534AB7;" vertex="1" parent="lg">
          <mxGeometry x="12" y="80" width="44" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lgS1t" value="Built, installed or extended by P3" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#2C2C2A;" vertex="1" parent="lg">
          <mxGeometry x="64" y="74" width="206" height="32" as="geometry" />
        </mxCell>
        <mxCell id="lgS2" value="" style="rounded=1;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;" vertex="1" parent="lg">
          <mxGeometry x="12" y="120" width="44" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lgS2t" value="Exists only during a session (make up to make down)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#2C2C2A;" vertex="1" parent="lg">
          <mxGeometry x="64" y="114" width="206" height="32" as="geometry" />
        </mxCell>
        <mxCell id="lgS3" value="" style="rounded=1;html=1;fillColor=#F1EFE8;strokeColor=#888780;" vertex="1" parent="lg">
          <mxGeometry x="12" y="160" width="44" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lgS3t" value="A layer below, or always on (drawn in its own diagram)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#2C2C2A;" vertex="1" parent="lg">
          <mxGeometry x="64" y="154" width="206" height="32" as="geometry" />
        </mxCell>
        <mxCell id="lgS4" value="" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;" vertex="1" parent="lg">
          <mxGeometry x="12" y="200" width="44" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lgS4t" value="Run by Google" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#2C2C2A;" vertex="1" parent="lg">
          <mxGeometry x="64" y="194" width="206" height="32" as="geometry" />
        </mxCell>
        <mxCell id="lgN" value="Burn rate: how fast failures use up the SLO&#39;s error budget. OTLP: the OpenTelemetry wire protocol. Span metrics: request rate, errors and latency counted from traces. DCGM: NVIDIA Data Center GPU Manager. KEDA: Kubernetes Event-driven Autoscaling. NAT: network address translation. vLLM: the open-source model server from P1. L4: the NVIDIA GPU it runs on." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#444441;" vertex="1" parent="lg">
          <mxGeometry x="10" y="236" width="260" height="156" as="geometry" />
        </mxCell>
        <mxCell id="P0" value="&lt;b&gt;Layer below: P0 foundation&lt;/b&gt; (see the 00-foundation diagrams) · custom VPC (Virtual Private Cloud) with private nodes and Private Google Access · keyless GitHub login through WIF (Workload Identity Federation), main branch only · deployer and node service accounts · budget alerts · nightly cost-guard" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F1EFE8;strokeColor=#888780;fontColor=#444441;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="20" y="925" width="1660" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="1 traces, cost" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5F5E5A;strokeWidth=1.5;fontSize=12;fontColor=#2C2C2A;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="zSys" source="GW" target="OT">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="2 traces" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5F5E5A;strokeWidth=1.5;fontSize=12;fontColor=#2C2C2A;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="zSys" source="OT" target="TP">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="3 scrape" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5F5E5A;strokeWidth=1.5;fontSize=12;fontColor=#2C2C2A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="zSys" source="PM" target="OT">
          <mxGeometry x="-0.2" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="805" y="222" />
            </Array>
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e3b" value="3 scrape GPU node" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5F5E5A;strokeWidth=1.5;fontSize=12;fontColor=#2C2C2A;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.369;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="zS" source="PM" target="zGpu">
          <mxGeometry x="0.6" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e4" value="4 alerts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5F5E5A;strokeWidth=1.5;fontSize=12;fontColor=#2C2C2A;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.85;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="zSys" source="PM" target="RC">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="5 queries" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5F5E5A;strokeWidth=1.5;fontSize=12;fontColor=#2C2C2A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="zSys" source="GF" target="ST">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="6 request rate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5F5E5A;strokeWidth=1.5;fontSize=12;fontColor=#2C2C2A;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="zSys" source="KD" target="PM">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="7 scale 0 → 1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5F5E5A;strokeWidth=1.5;fontSize=12;fontColor=#2C2C2A;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="zS" source="KD" target="P1">
          <mxGeometry x="-0.5" relative="1" as="geometry">
            <mxPoint as="offset" />
