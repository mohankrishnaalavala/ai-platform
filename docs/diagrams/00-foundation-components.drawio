<mxfile host="drawio" compressed="false">
  <diagram id="p0-foundation-components" name="P0 Foundation components">
    <mxGraphModel background="#FFFFFF" dx="1900" dy="640" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="640" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;font style=&quot;font-size:20px&quot;&gt;&lt;b&gt;P0 Foundation: components&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Develop free on the laptop. Create the GPU (graphics processing unit) cluster only for a session. CI (continuous integration) logs in without keys." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#2C2C2A;" vertex="1" parent="1">
          <mxGeometry x="20" y="12" width="1400" height="60" as="geometry" />
        </mxCell>
        <mxCell id="zL" value="Laptop (you)" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=3;container=1;collapsible=0;fontStyle=1;fontSize=13;align=left;spacingLeft=12;fillColor=#FFFFFF;swimlaneFillColor=#FFFFFF;strokeColor=#5F5E5A;fontColor=#2C2C2A;" vertex="1" parent="1">
          <mxGeometry x="20" y="90" width="600" height="200" as="geometry" />
        </mxCell>
        <mxCell id="L2" value="&lt;b&gt;Laptop mode&lt;/b&gt;&lt;br&gt;kind (Kubernetes in Docker) + Ollama&lt;br&gt;tiny model, no GPU" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="zL">
          <mxGeometry x="30" y="50" width="250" height="120" as="geometry" />
        </mxCell>
