<mxfile host="drawio" compressed="false">
  <diagram id="p0-foundation-security" name="P0 Foundation security">
    <mxGraphModel background="#FFFFFF" dx="1920" dy="710" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="710" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;font style=&quot;font-size:20px&quot;&gt;&lt;b&gt;P0 Foundation: identity and security&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Who acts as whom. GitHub swaps its OIDC (OpenID Connect) token for a short-lived login through WIF (Workload Identity Federation). The laptop impersonates the same service accounts with a short-lived token. GKE (Google Kubernetes Engine) nodes run as their own service account." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#2C2C2A;" vertex="1" parent="1">
          <mxGeometry x="20" y="12" width="1600" height="60" as="geometry" />
        </mxCell>
        <mxCell id="zG" value="GitHub (public repo)" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=3;container=1;collapsible=0;fontStyle=1;fontSize=13;align=left;spacingLeft=12;fillColor=#FFFFFF;swimlaneFillColor=#FFFFFF;strokeColor=#5F5E5A;fontColor=#2C2C2A;" vertex="1" parent="1">
          <mxGeometry x="20" y="90" width="300" height="180" as="geometry" />
        </mxCell>
        <mxCell id="G1" value="&lt;b&gt;Cloud workflows&lt;/b&gt; (run from main)&lt;br&gt;foundation.yml&lt;br&gt;gpu-session.yml, cost-guard.yml" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#2C2C2A;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="zG">
          <mxGeometry x="20" y="40" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="zL" value="Laptop (you)" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=3;container=1;collapsible=0;fontStyle=1;fontSize=13;align=left;spacingLeft=12;fillColor=#FFFFFF;swimlaneFillColor=#FFFFFF;strokeColor=#5F5E5A;fontColor=#2C2C2A;" vertex="1" parent="1">
          <mxGeometry x="20" y="290" width="300" height="240" as="geometry" />
        </mxCell>
        <mxCell id="L1" value="&lt;b&gt;You&lt;/b&gt;&lt;br&gt;gcloud configuration ai-platform" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="zL">
