        <mxCell id="lgS3t" value="A layer below (drawn in its own diagram)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#2C2C2A;" vertex="1" parent="lg">
          <mxGeometry x="64" y="154" width="286" height="32" as="geometry" />
        </mxCell>
        <mxCell id="lgS4" value="" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;" vertex="1" parent="lg">
          <mxGeometry x="12" y="200" width="44" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lgS4t" value="Run by Google" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#2C2C2A;" vertex="1" parent="lg">
          <mxGeometry x="64" y="194" width="286" height="32" as="geometry" />
        </mxCell>
        <mxCell id="P0" value="&lt;b&gt;Layer below: P0 foundation&lt;/b&gt; (see the 00-foundation diagrams) · keyless GitHub login through WIF (Workload Identity Federation), main branch only; P4 lets release-model.yml act as the deployer · Secret Manager: the gateway master key, read into memory only by the runner and promote.py · custom VPC (Virtual Private Cloud), private nodes, Private Google Access · budget alerts, nightly cost-guard" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F1EFE8;strokeColor=#888780;fontColor=#444441;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="20" y="785" width="1260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="acr" value="GKE: Google Kubernetes Engine. LiteLLM: the open-source LLM (large language model) gateway from P2. vLLM: the open-source model server from P1. TTFT: time to first token; p95: the 95th percentile. PR: pull request. L4: the NVIDIA GPU. BF16 / FP8: 16-bit and 8-bit model weights. Golden set: 100 test cases written and checked by hand. Judge: a model that scores open answers against a fixed rubric." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#444441;" vertex="1" parent="1">
          <mxGeometry x="20" y="853" width="1260" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="1 eval calls" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5F5E5A;strokeWidth=1.5;fontSize=12;fontColor=#2C2C2A;labelBackgroundColor=#FFFFFF;exitX=0.161;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.273;entryDx=0;entryDy=0;" edge="1" parent="1" source="RN" target="GW">
          <mxGeometry x="-0.556" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1400" y="440" />
            </Array>
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e2" value="2 self-hosted candidates" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5F5E5A;strokeWidth=1.5;fontSize=12;fontColor=#2C2C2A;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="zS" source="GW" target="VL">
          <mxGeometry relative="1" as="geometry" />
