<mxfile host="drawio" compressed="false">
  <diagram id="p4-eval-gated-releases-components" name="P4 eval-gated releases components">
    <mxGraphModel background="#FFFFFF" dx="1700" dy="920" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="920" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;font style=&quot;font-size:20px&quot;&gt;&lt;b&gt;P4 Eval-gated model releases: components&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Model, prompt and gateway changes are tested before merge (lines 1–4) and released as a canary that rolls itself back (lines 5–8). Real eval runs happen in one session cluster window, from the laptop; pull request checks only verify the committed results file. Nothing is public." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#2C2C2A;" vertex="1" parent="1">
          <mxGeometry x="20" y="12" width="1660" height="60" as="geometry" />
        </mxCell>
        <mxCell id="zT" value="GitHub Actions · Google login only from main, keyless" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=3;container=1;collapsible=0;fontStyle=1;fontSize=13;align=left;spacingLeft=12;fillColor=#FFFFFF;swimlaneFillColor=#FFFFFF;strokeColor=#5F5E5A;fontColor=#2C2C2A;" vertex="1" parent="1">
          <mxGeometry x="20" y="85" width="1260" height="170" as="geometry" />
        </mxCell>
        <mxCell id="PR" value="&lt;b&gt;Canary promoter&lt;/b&gt; (our promote.py)&lt;br&gt;release-model.yml, keyless as the deployer&lt;br&gt;10 → 50 → 100%; on failure: weight 0, opens an issue" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#534AB7;fontColor=#2C2C2A;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="zT">
          <mxGeometry x="240" y="45" width="420" height="100" as="geometry" />
        </mxCell>
        <mxCell id="EV" value="&lt;b&gt;Eval gate&lt;/b&gt; (evals.yml, on PRs)&lt;br&gt;checks config hash + thresholds&lt;br&gt;no Google login; posts scores" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#534AB7;fontColor=#2C2C2A;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="zT">
          <mxGeometry x="940" y="45" width="270" height="100" as="geometry" />
        </mxCell>
        <mxCell id="zL" value="Laptop · as the deployer, via port-forward" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=3;container=1;collapsible=0;fontStyle=1;fontSize=13;align=left;spacingLeft=12;fillColor=#FFFFFF;swimlaneFillColor=#FFFFFF;strokeColor=#5F5E5A;fontColor=#2C2C2A;" vertex="1" parent="1">
          <mxGeometry x="1320" y="85" width="360" height="170" as="geometry" />
        </mxCell>
        <mxCell id="RN" value="&lt;b&gt;Eval runner&lt;/b&gt; (our evals/run.py)&lt;br&gt;golden set, scorers, judge rubric&lt;br&gt;any fallback answer: run INVALID" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#534AB7;fontColor=#2C2C2A;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="zL">
          <mxGeometry x="30" y="45" width="310" height="100" as="geometry" />
        </mxCell>
        <mxCell id="zS" value="Session: GKE cluster" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=3;container=1;collapsible=0;fontStyle=1;fontSize=13;align=left;spacingLeft=12;fillColor=#EEEDFE;swimlaneFillColor=#F7F6FF;strokeColor=#534AB7;fontColor=#3C3489;" vertex="1" parent="1">
          <mxGeometry x="20" y="285" width="1260" height="480" as="geometry" />
        </mxCell>
        <mxCell id="sN" value="Private nodes. No load balancer, no public IP. One cluster for the whole P4 + P5 window; the probe Job is the only pod P4 adds." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#3C3489;" vertex="1" parent="zS">
          <mxGeometry x="910" y="33" width="330" height="46" as="geometry" />
        </mxCell>
        <mxCell id="zSys" value="System node pool · 1× e2-standard-8" style="html=1;whiteSpace=wrap;rounded=1;arcSize=3;container=1;collapsible=0;fontStyle=1;fontSize=12;align=right;verticalAlign=top;spacingRight=12;spacingTop=4;fillColor=#FFFFFF;strokeColor=#534AB7;fontColor=#3C3489;" vertex="1" parent="zS">
          <mxGeometry x="20" y="85" width="1220" height="195" as="geometry" />
        </mxCell>
        <mxCell id="PM" value="&lt;b&gt;Error rates&lt;/b&gt; (P3 Prometheus)&lt;br&gt;P4 adds one span-metric label:&lt;br&gt;litellm.provider.model" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#534AB7;fontColor=#2C2C2A;fontSize=11;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="zSys">
          <mxGeometry x="20" y="45" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="JB" value="&lt;b&gt;TTFT probe&lt;/b&gt; (short Kubernetes Job)&lt;br&gt;streams to chat-hosted&lt;br&gt;TTFT p95 per deployment" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#534AB7;fontColor=#2C2C2A;fontSize=11;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="zSys">
          <mxGeometry x="380" y="45" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="GW" value="&lt;b&gt;LLM gateway&lt;/b&gt; (LiteLLM, from P2)&lt;br&gt;P4 adds a judge alias (temperature 0)&lt;br&gt;and canary weights on chat-hosted" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#534AB7;fontColor=#2C2C2A;fontSize=11;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="zSys">
          <mxGeometry x="840" y="40" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="zGpu" value="GPU node pool · 1× NVIDIA L4, on-demand · starts at 0 nodes" style="html=1;whiteSpace=wrap;rounded=1;arcSize=3;container=1;collapsible=0;fontStyle=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fillColor=#FFFFFF;strokeColor=#534AB7;fontColor=#3C3489;" vertex="1" parent="zS">
          <mxGeometry x="20" y="310" width="1220" height="150" as="geometry" />
        </mxCell>
        <mxCell id="VL" value="&lt;b&gt;Layer below: P1 vLLM&lt;/b&gt; on the L4&lt;br&gt;BF16, FP8, then the candidates, one at a time&lt;br&gt;offline evals only; at 0 during the canary" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F1EFE8;strokeColor=#888780;fontColor=#444441;fontSize=11;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="zGpu">
          <mxGeometry x="820" y="40" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="zG" value="Google Cloud APIs · Private Google Access" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=3;container=1;collapsible=0;fontStyle=1;fontSize=12;align=left;spacingLeft=12;fillColor=#FFFFFF;swimlaneFillColor=#FFFFFF;strokeColor=#5F5E5A;fontColor=#2C2C2A;" vertex="1" parent="1">
          <mxGeometry x="1320" y="470" width="360" height="150" as="geometry" />
        </mxCell>
        <mxCell id="VX" value="&lt;b&gt;Gemini on Vertex AI&lt;/b&gt;&lt;br&gt;canary: 3.5 Flash-Lite → 3.5 Flash&lt;br&gt;judge: Flash · keyless (Workload Identity)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=11;align=left;verticalAlign=middle;spacingLeft=60;spacingRight=8;" vertex="1" parent="zG">
          <mxGeometry x="20" y="45" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="VXi" value="" style="sketch=0;html=1;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;align=center;fontSize=11;fontStyle=0;fontColor=#000000;aspect=fixed;pointerEvents=1;shape=mxgraph.gcp3.vertexai;fillColor=#4285f4" vertex="1" parent="VX">
          <mxGeometry x="10" y="25" width="40" height="39" as="geometry" />
        </mxCell>
