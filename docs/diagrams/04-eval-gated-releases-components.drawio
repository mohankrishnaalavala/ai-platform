        <mxCell id="e5" value="5 deploy, weights" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5F5E5A;strokeWidth=1.5;fontSize=12;fontColor=#2C2C2A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.107;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="PR" target="GW">
          <mxGeometry x="0.391" relative="1" as="geometry">
