          <mxGeometry x="1320" y="645" width="360" height="240" as="geometry" />
        </mxCell>
        <mxCell id="lgT" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#2C2C2A;" vertex="1" parent="lg">
          <mxGeometry x="10" y="8" width="340" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lgL1" value="" style="line;html=1;strokeWidth=1.5;strokeColor=#5F5E5A;" vertex="1" parent="lg">
          <mxGeometry x="12" y="40" width="44" height="10" as="geometry" />
        </mxCell>
        <mxCell id="lgL1t" value="Call, in request order. 1–4: evals before merge. 5–8: the canary after merge" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#2C2C2A;" vertex="1" parent="lg">
          <mxGeometry x="64" y="28" width="286" height="36" as="geometry" />
